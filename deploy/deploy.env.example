# Deployment settings for scripts/deploy.sh. Copy to deploy/deploy.env
# (gitignored) and fill in. One KEY=value per line, no quotes, no spaces.
# A variable already set in the environment wins over this file.

# ssh destination of the server (an alias from ~/.ssh/config), or "local"
# to run every command on this machine.
DEPLOY_HOST=deploy-host
# Directory on the server for compose/env files, the deploy lock and backups.
DEPLOY_DIR=/srv/dogfight
# The nginx container that proxies the game, and the vhost file on the
# server that holds the `set $dogfight_upstream ...;` line (bind-mounted
# into that container as a single file).
NGINX_CONTAINER=edge-nginx
NGINX_CONF=/srv/edge/nginx/default.conf
# External docker network shared by nginx and the dogfight containers.
EDGE_NETWORK=edge-net
# Public host name of the game: WebSocket origin check and CSP connect-src.
PUBLIC_HOST=dogfight.example.com
# How long a draining color keeps its players before it exits.
DRAIN_MAX=30m
